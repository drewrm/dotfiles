{
    "cpu": {
	"format": " {usage}%",
	"tooltip": true,
	"interval": 1,
        "on-click": "~/.config/waybar/scripts/start-or-focus.sh btop"
    },
    "disk": {
	"interval": 30,
	"format": " {percentage_used}%",
	"tooltip": true,
        "on-click" : "~/.config/waybar/scripts/start-or-focus.sh yazi"
    },
    "memory": {
	"format": " {percentage}%",
	"tooltip": true,
	"interval": 1,
        "on-click": "~/.config/waybar/scripts/start-or-focus.sh btop"
    },
    "temperature": {
        "critical-threshold": 85,
        "interval": 1,
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "", "", "", "", ""
        ],
        "on-click": "~/.config/waybar/scripts/start-or-focus.sh btop"

    }
}
