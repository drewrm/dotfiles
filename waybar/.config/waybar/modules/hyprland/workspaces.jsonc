{
    "hyprland/workspaces": {
        "format": " {icon} ",
        "format-icons": {
            "default": "",
            "active": ""
        },
        "max-workspaces": 5,
        "show-special": true,
        "on-scroll-up": "hyprctl dispatch workspace +1",
        "on-scroll-down": "hyprctl dispatch workspace -1",
        "cursor": true
    },
    "hyprland/window": {
        "format": "{title}",
        "rewrite": {
            "": "Desktop",
            "(.*) - Contour": "Terminal"
        }
    }
}
