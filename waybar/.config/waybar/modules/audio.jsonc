{
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "dynamic-len": 100,
        "dynamic-order": ["title", "artist", "album"],
        "status-icons": {
            "default": "▶",
            "paused": "⏸",
            "stopped": "󰓛"
        }
    },
    "custom/audio-icon": {
        "format": "󰕾"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100
    }
}
