{
    "clock": {
        "format": "{:%a %d %b %H:%M:%S %Z}",
        "timezones": [
            "Australia/Sydney",
            "Asia/Hong_Kong",
            "Europe/Stockholm"
        ],
        "tooltip": true,
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 4,
            "format" : {
                "weekdays": "<span><b>{}</b></span>",
                "months": "<span color='#9ece6a'><b>{}</b></span>",
                "today": "<span bgcolor='#9ece6a' color='#15161E'>{}</span>" // Customize today's date color
            }
        },
        "interval": 1,
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down"
        }
    }
}
