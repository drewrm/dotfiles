{
	"clock": {
		"format": "{:%H:%M:%S %b %d %Z}",
		"calendar": {
			"mode": "year",
			"mode-mon-col": 4
		},
		"timezones": [
			"Australia/Sydney",
			"Asia/Hong_Kong",
			"Europe/Stockholm"
		],
		"tooltip": true,
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"interval": 1,
		"actions": {
			"on-click-right": "mode",
			"on-scroll-up": "tz_up",
			"on-scroll-down": "tz_down"
		}
	}
}
