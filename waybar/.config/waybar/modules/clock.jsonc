{
    "clock": {
        "format": "{:%a %d %b %H:%M:%S %Z}",
        "timezones": [
            "Australia/Sydney",
            "Asia/Hong_Kong",
            "Europe/Stockholm"
        ],
        "tooltip": true,
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 4,
            "format" : {
                "weekdays": "<span><b>{}</b></span>",
                "months": "<span color='#bb9af7'><b>{}</b></span>",
                "today": "<span bgcolor='#bb9af7' color='#15161E'><b><i>{}</i></b></span>" // Customize today's date color
            }
        },
        "interval": 1,
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down"
        }
    }
}
